# Root environment file — THIS is the one Docker Compose reads.
#
# Everything Compose injects into the api, queue, and scheduler containers is
# defined here. A value set in backend/.env instead is silently ignored, because
# Compose's value becomes a real environment variable and Laravel reads $_SERVER
# before the dotenv file. Keys not listed here belong in backend/.env.
#
# Copy to .env and fill in. After any change: docker compose up -d

APP_NAME=ATMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_DATABASE=atms
DB_USERNAME=atms
DB_PASSWORD=secret

SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost

# Compose defaults these; uncomment to override.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# CORS_SUPPORTS_CREDENTIALS=true

QUEUE_CONNECTION=database

ATMS_COMPANY_TIMEZONE=Africa/Tripoli
ATMS_ATTACHMENT_DISK=attachments

LDC_ERP_TENANT_ID=
LDC_ERP_CLIENT_ID=
LDC_ERP_CLIENT_SECRET=
LDC_ERP_ENVIRONMENT=
LDC_ERP_COMPANY=
LDC_ERP_PARTS_API=

# ---- Email -------------------------------------------------------------------
# Compose passes these into the api, queue, and scheduler containers. They must be
# set HERE, in the root env file. A value set only in backend/.env is ignored:
# Compose injects its empty default as a real environment variable, and Laravel
# reads $_SERVER before the dotenv file.

# `fake` records sends in memory and delivers nothing; `graph` sends real mail.
# This one switch governs account AND workflow email.
ACCOUNT_EMAIL_TRANSPORT=fake

# Base URL of the Vue SPA. Every email deep link is built from this, so a wrong
# value produces mail that delivers but cannot be opened.
FRONTEND_URL=

# Optional blind-copy on every message. Empty = no BCC.
ACCOUNT_EMAIL_BCC=

# Microsoft Graph sendMail (OAuth2 client-credentials). A SEPARATE Entra ID app
# registration from the LDC_ERP_* app above.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=notification@ldc.com.ly

WEB_PORT=80

# ---- Compose file selection (PRODUCTION ONLY) --------------------------------
# Leave this commented out for local development: the bare `docker compose up -d`
# then auto-loads compose.override.yaml, which is what gives dev its bind mounts
# and OPcache hot-reload.
#
# On the VPS, UNCOMMENT IT. Compose auto-loads compose.override.yaml for every
# command that does not pass explicit `-f` flags, and that override sets
# APP_DEBUG=true, bind-mounts ./backend over the image, and mounts zzz-dev.ini —
# which re-enables opcache.validate_timestamps and costs 20–40% of throughput
# (see docker/backend/php/zz-atms.ini). deploy.sh passes its own `-f` flags, but
# everything in scripts/ runs a bare `docker compose`, and so does anyone
# debugging by hand. COMPOSE_FILE closes that gap for all of them at once.
#
# COMPOSE_FILE=compose.yaml:compose.production.yaml
