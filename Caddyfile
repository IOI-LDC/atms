# ===========================================================================
# ATMS — production reverse proxy (single host, same-origin)
# --------------------------------------------------------------------------
# Run on the VPS (NOT in Docker). One site block for assets.ldc.com.ly:
#
#   /api/*, /sanctum/*, /storage/*, /up → reverse-proxied to the Docker
#     "nginx" container (port 8080 = BACKEND_PORT) — Laravel API, Sanctum
#     endpoints, the public storage disk, and the framework health check.
#   /favicon.ico, /favicon.svg, /apple-touch-icon.png, /robots.txt → served
#     from the SPA build, but WITHOUT the SPA fallback, so a missing one
#     returns 404 rather than a 200 full of HTML.
#   everything else → the built Vue SPA (static files + SPA fallback).
#
# Both matchers are declared before the catch-all `handle` block: Caddy's
# `handle` directives short-circuit on first match, so ordering here is
# load-bearing — moving the catch-all up would swallow every request.
#
# Terminates TLS automatically (Let's Encrypt via Caddy).
#
# Install:
#   sudo apt install caddy
#   sudo cp Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# DNS: assets.ldc.com.ly must resolve (A record or CNAME) to this VPS's
# public IP. Caddy cannot issue a cert until DNS resolves.
# ===========================================================================

{$APP_HOST:assets.ldc.com.ly} {
	encode gzip zstd

	# Laravel-served paths go to the Docker stack (nginx container = BACKEND_PORT).
	# Cookie auth + bearer auth both work through this.
	@backend path /api/* /sanctum/* /storage/* /up
	handle @backend {
		reverse_proxy 127.0.0.1:{$BACKEND_PORT:8080} {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	# Root-level static files, served WITHOUT the SPA fallback below.
	#
	# `try_files {path} /index.html` turns any missing file into a 200 carrying
	# index.html, so a favicon that never made it into dist/ is served to the
	# browser as an HTML document — it silently shows the default icon and
	# nothing, anywhere, logs an error. These paths 404 honestly instead.
	@rooticons path /favicon.ico /favicon.svg /apple-touch-icon.png /robots.txt
	handle @rooticons {
		root * /srv/atms/frontend/dist
		file_server
	}

	# Everything else: built Vue bundle. `npm run build` in frontend/ produces
	# frontend/dist/.
	handle {
		root * /srv/atms/frontend/dist

		# SPA fallback: unknown paths return index.html so vue-router resolves them.
		try_files {path} /index.html
		file_server

		# Fingerprinted Vite assets are immutable; cache aggressively.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
	}

	# Match nginx.conf's 25m upload limit for any future form posts.
	request_body {
		max_size 30MB
	}

	log {
		output file /var/log/caddy/assets.log
		format console
	}
}
